    mdhn:form "سی" ;
    mdhn:lemma "سی" ;
    mdhn:pos "NUM" ;
    mdhn:subtype "cardinal" .

# ── Hemistich 2 ─────────────────────────────────────
mdhn:SHN_NWSH_V001_H2 a mdhn:Hemistich ;
    mdhn:verse mdhn:SHN_NWSH_V001 ;
