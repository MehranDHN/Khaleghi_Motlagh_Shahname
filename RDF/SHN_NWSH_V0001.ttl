# ── Hemistich 1 ─────────────────────────────────────
mdhn:SHN_NWSH_V001_H1 a mdhn:Hemistich ;
    mdhn:verse mdhn:SHN_NWSH_V001 ;
    mdhn:order 1 ;
    mdhn:text "نبشتن یکی نه که نزدیک سی" .

mdhn:TK_N01 a mdhn:Token ;
    mdhn:hemistich mdhn:SHN_NWSH_V001_H1 ;
    mdhn:form "نبشتن" ;
    mdhn:lemma "نبشتن" ;
    mdhn:pos "NOUN" ;
    mdhn:subtype "verbal-noun" ;
    mdhn:modernEquivalent "نوشتن" ;
    skos:note "Archaic masdar used as grammatical subject"@en .

mdhn:TK_N02 a mdhn:Token ;
    mdhn:hemistich mdhn:SHN_NWSH_V001_H1 ;
    mdhn:form "یکی" ;
    mdhn:lemma "یک" ;
    mdhn:pos "NUM" ;
    mdhn:subtype "cardinal" .

mdhn:TK_N03 a mdhn:Token ;
    mdhn:hemistich mdhn:SHN_NWSH_V001_H1 ;
