# =============================================
# Verse 1 - SHN_NWSH_V001
# =============================================

mdhn:SHN_NWSH_V001 a mdhn:Verse ;
    crm:P1_is_identified_by "SHN_NWSH_V001" ;
    mdhn:hasHemistich mdhn:SHN_NWSH_V001_H1 ,
                      mdhn:SHN_NWSH_V001_H2 ;
    mdhn:teiXmlRef "https://raw.githubusercontent.com/MehranDHN/Khaleghi_Motlagh_Shahname/main/demo/tei/SHN_NWSH_V001-V003.xml#SHN_NWSH_V001"^^xsd:anyURI ;
