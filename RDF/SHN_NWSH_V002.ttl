# ── Hemistich 2 ─────────────────────────────────────
mdhn:SHN_NWSH_V002_H2 a mdhn:Hemistich ;
    mdhn:verse mdhn:SHN_NWSH_V002 ;
    mdhn:order 2 ;
    mdhn:text "نگاریدن آن کجا بشنوی" .

mdhn:TK_N21 a mdhn:Token ;
    mdhn:hemistich mdhn:SHN_NWSH_V002_H2 ;
    mdhn:form "نگاریدن" ;
    mdhn:lemma "نگاریدن" ;
    mdhn:pos "NOUN" ;
    mdhn:subtype "verbal-noun" ;
    mdhn:modernEquivalent "نگاشتن / نوشتن" ;
    skos:note "Archaic form meaning 'to depict / to record'"@en .

mdhn:TK_N22 a mdhn:Token ;
    mdhn:hemistich mdhn:SHN_NWSH_V002_H2 ;
    mdhn:form "آن" ;
