mdhn:TK_N24 a mdhn:Token ;
    mdhn:hemistich mdhn:SHN_NWSH_V002_H2 ;
    mdhn:form "بشنوی" ;
    mdhn:lemma "شنیدن" ;
    mdhn:pos "VERB" ;
    mdhn:subtype "subjunctive" ;
    skos:note "2nd person singular subjunctive" .
